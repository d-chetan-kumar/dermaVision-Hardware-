# ==============================================================================
# DermaVision — Repository .gitignore
# ==============================================================================

# 1. Raw ISIC 2019 Dataset & Raw Dataset CSVs
# Keep experiment CSVs in results/, metrics/, and data/splits/ tracked while ignoring raw datasets.
ISIC_2019_Training_Input/
dermavision-isic-2019/
ISIC_2019_Training_GroundTruth.csv
ISIC_2019_Training_Metadata.csv
ISIC_2019_*.csv

# 2. Large Intermediate / Rejected Model Checkpoints & Caches (>50-100 MB or redundant)
# Compact deployment .tflite models (~3 MB) and small linear-probe .pth heads (~11 KB) remain tracked.
# Note: Original models/best_mobilenetv2.keras (already tracked) stays tracked for Grad-CAM / baseline reference.
models/*.keras
models/**/*.keras
models/*.h5
models/dinov2/*.pth
results/pruning/checkpoints/
*.h5
*.pb
dinov2_vitb14_pretrain.pth

# 3. Kaggle Packaging Archives & Temporary Scratch Files
dermavision_kaggle_pack/
dermavision_kaggle_pack.zip
scratch/
scratch_*.png

# 4. Python, TensorFlow, Keras & Matplotlib Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.keras_cache/

# 5. Virtual Environments
.env
.env.*
.venv
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# 6. Secrets, Credentials & Keys
.streamlit/secrets.toml
.streamlit/credentials.toml
secrets.json
credentials.json
*.pem
*.key

# 7. IDEs, Editors & Logs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.log

# LaTeX build artefacts (manuscript)
ISIC_Dermavision_Manuscript/*.aux
ISIC_Dermavision_Manuscript/*.log
ISIC_Dermavision_Manuscript/*.out
ISIC_Dermavision_Manuscript/*.spl
ISIC_Dermavision_Manuscript/*.fls
ISIC_Dermavision_Manuscript/*.fdb_latexmk
ISIC_Dermavision_Manuscript/*.synctex.gz
